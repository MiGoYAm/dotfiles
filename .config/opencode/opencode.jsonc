{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "title": {
      "model": "opencode/big-pickle",
    },
  },
  "plugins": [
    "@alergeek-ventures/opencode@latest",
  ],
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"],
      },
    },
  },
  "permissions": [
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow",
    },
  ],
}
