  {
    "rule": "react-doctor/async-parallel",
    "guideline": "async-parallel",
    "bad": "async function load(){const a=await fetchA();const b=await fetchB();const c=await fetchC();return [a,b,c]}",
    "good": "async function load(){return Promise.all([fetchA(),fetchB(),fetchC()])}",
    "accepted": [
      "async function load(){const a=await fetchA();const b=await fetchB(a);const c=await fetchC(b);return [a,b,c]}"
    ]
  },
  {
    "rule": "react-doctor/server-after-nonblocking",
    "guideline": "server-after-nonblocking",
    "bad": "\"use server\";export async function save(){await analytics.track(\"saved\");}",
    "good": "\"use server\";import {after} from \"next/server\";export async function save(){after(()=>analytics.track(\"saved\"));}"
  },
  {
    "rule": "react-doctor/rerender-dependencies",
    "guideline": "rerender-dependencies",
    "bad": "import {useEffect} from \"react\";function C(){useEffect(()=>sync(),[{}]);return null;}",
    "good": "import {useEffect} from \"react\";function C({id}){useEffect(()=>sync(id),[id]);return null;}"
  },
  {
    "rule": "react-doctor/rerender-transitions-scroll",
    "guideline": "rerender-transitions",
    "bad": "import {useState} from \"react\";function C(){const [v,setV]=useState(0);window.addEventListener(\"scroll\",()=>setV(window.scrollY));return <p>{v}</p>}",
    "good": "import {useState,startTransition} from \"react\";function C(){const [v,setV]=useState(0);window.addEventListener(\"scroll\",()=>startTransition(()=>setV(window.scrollY)));return <p>{v}</p>}"
  },
  {
    "rule": "react-doctor/rendering-hoist-jsx",
    "guideline": "rendering-hoist-jsx",
    "bad": "function C(){const icon=<svg><path d=\"M0 0\"/></svg>;return <div>{icon}</div>}",
    "good": "const icon=<svg><path d=\"M0 0\"/></svg>;function C(){return <div>{icon}</div>}"
  },
  {
    "rule": "react-doctor/rendering-svg-precision",
    "guideline": "rendering-svg-precision",
    "bad": "function C(){return <svg><path d=\"M 10.293847 20.847362 L 30.938472 40.192837\"/></svg>}",
    "good": "function C(){return <svg><path d=\"M 10.3 20.8 L 30.9 40.2\"/></svg>}"
  },
  {
    "rule": "react-doctor/js-index-maps",
    "guideline": "js-index-maps",
    "bad": "function run(users,ids){for(const id of ids){const u=users.find(u=>u.id===id);show(u)}}",
    "good": "function run(users,ids){const map=new Map(users.map(u=>[u.id,u]));for(const id of ids)show(map.get(id))}"
  },
  {
    "rule": "react-doctor/js-cache-property-access",
    "guideline": "js-cache-property-access",
    "bad": "function run(obj,arr){for(const x of arr){consume(obj.config.value);consume(obj.config.value);consume(obj.config.value)}}",
    "good": "function run(obj,arr){for(const x of arr){const v=obj.config.value;consume(v);consume(v);consume(v)}}"
  },
  {
    "rule": "react-doctor/js-combine-iterations",
    "guideline": "js-combine-iterations",
    "bad": "function run(users){return users.filter(u=>u.active).map(u=>u.name)}",
    "good": "function run(users){const result=[];for(const u of users){if(u.active)result.push(u.name)}return result}"
  },
  {
    "rule": "react-doctor/js-length-check-first",
    "guideline": "js-length-check-first",
    "bad": "function equal(a,b){return a.every((x,i)=>x===b[i]);}",
    "good": "function equal(a,b){return a.length===b.length&&a.every((x,i)=>x===b[i]);}"
  },
