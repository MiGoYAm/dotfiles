  {
    "rule": "react-doctor/nextjs-no-use-search-params-without-suspense",
    "guideline": "async-suspense-boundaries",
    "filename": "page.tsx",
    "bad": "'use client'; import {useSearchParams} from 'next/navigation'; export default function Page(){const p=useSearchParams(); return <p>{p.get('q')}</p>}",
    "good": "'use client'; import {Suspense} from 'react'; import {useSearchParams} from 'next/navigation'; function Search(){const p=useSearchParams();return <p>{p.get('q')}</p>} export default function Page(){return <Suspense fallback={null}><Search/></Suspense>}",
    "accepted": [
      "async function Page() {\n  const data = await fetchData() // Blocks entire page\n  \n  return (\n    <div>\n      <div>Sidebar</div>\n      <div>Header</div>\n      <div>\n        <DataDisplay data={data} />\n      </div>\n      <div>Footer</div>\n    </div>\n  )\n}\n"
    ]
  },
  {
    "rule": "react-doctor/js-set-map-lookups",
    "guideline": "js-set-map-lookups",
    "bad": "export function select(items, allowed) { return items.filter(item => allowed.includes(item.id)); }",
    "good": "export function select(items, allowed) { const allowedSet = new Set(allowed); return items.filter(item => allowedSet.has(item.id)); }",
    "accepted": [
      "export function search(items, text) { return items.filter(item => text.includes(item.name)); }"
    ]
  },
  {
    "rule": "react-doctor/async-await-in-loop",
    "guideline": "async-parallel",
    "bad": "export async function load(ids) { const results = []; for (const id of ids) { results.push(await fetchItem(id)); } return results; }",
    "good": "export async function load(ids) { return Promise.all(ids.map(id => fetchItem(id))); }",
    "accepted": [
      "export async function reduce(ids) { let previous = null; for (const id of ids) { previous = await fetchItem(id, previous); } return previous; }"
    ]
  },
  {
    "rule": "react-doctor/rerender-state-only-in-handlers",
    "guideline": "rerender-use-ref-transient-values",
    "bad": "import {useState} from \"react\"; export function Counter(){const [count,setCount]=useState(0); return <button onClick={() => {setCount(count+1);}}>Track</button>;}",
    "good": "import {useRef} from \"react\"; export function Counter(){const count=useRef(0);return <button onClick={() => {count.current += 1;}}>Track</button>;}",
    "accepted": [
      "import {useState} from \"react\"; export function Counter(){const [count,setCount]=useState(0); return <button onClick={() => setCount(count+1)}>{count}</button>;}",
      "import {useState,useEffect} from \"react\";\nfunction Tracker() {\n  const [lastX, setLastX] = useState(0)\n\n  useEffect(() => {\n    const onMove = (e: MouseEvent) => setLastX(e.clientX)\n    window.addEventListener('mousemove', onMove)\n    return () => window.removeEventListener('mousemove', onMove)\n  }, [])\n\n  return (\n    <div\n      style={{\n        position: 'fixed',\n        top: 0,\n        left: lastX,\n        width: 8,\n        height: 8,\n        background: 'black',\n      }}\n    />\n  )\n}\n"
    ]
  },
  {
    "rule": "react-doctor/auth-token-in-web-storage",
    "guideline": "client-localstorage-schema",
    "bad": "localStorage.setItem('accessToken',token)",
    "good": "localStorage.setItem('prefs:v1',JSON.stringify({theme:'dark'}))",
    "accepted": [
      "localStorage.setItem('data',jwt)"
    ]
  },
  {
    "rule": "react-doctor/no-unsafe-json-parse",
    "guideline": "client-localstorage-schema",
    "bad": "function load(){return JSON.parse(localStorage.getItem('prefs:v1')).theme}",
    "good": "function load(){try{return JSON.parse(localStorage.getItem('prefs:v1')).theme}catch{return 'light'}}"
  },
  {
    "rule": "react-doctor/js-batch-dom-css",
    "guideline": "js-batch-dom-css",
    "bad": "function run(els){for(const el of els){const width=el.offsetWidth;el.style.width=width+'px';el.style.height='20px';}}",
    "good": "function run(els){for(const el of els){el.style.width='10px';el.style.height='20px';}}"
  },
  {
    "rule": "react-doctor/no-match-media-in-state-initializer",
    "guideline": "rendering-hydration-no-flicker",
    "bad": "import {useState} from \"react\"; function App(){const [mobile]=useState(()=>typeof window!=='undefined'&&window.matchMedia('(max-width: 767px)').matches);return <div>{mobile}</div>}",
    "good": "import {useSyncExternalStore} from \"react\"; const subscribe=()=>()=>{}; function App(){const mobile=useSyncExternalStore(subscribe,()=>window.matchMedia(\"(max-width: 767px)\").matches,()=>false);return <div>{mobile}</div>}"
  },
  {
    "rule": "react-doctor/no-nondeterministic-id-value-in-render-body",
    "guideline": "rendering-hydration-suppress-warning",
    "bad": "import {nanoid} from 'nanoid';function App(){const id=nanoid();return <input id={id}/>}",
    "good": "import {useId} from \"react\"; function App(){const id=useId();return <input id={id}/>}"
  },
  {
    "rule": "react-doctor/no-unguarded-browser-global-at-module-scope",
    "guideline": "rendering-hydration-no-flicker",
    "bad": "const theme=localStorage.getItem('theme');function App(){return <div>{theme}</div>}",
    "good": "const theme=typeof localStorage!=='undefined'?localStorage.getItem('theme'):'light';function App(){return <div>{theme}</div>}"
  },
  {
    "rule": "react-doctor/no-hydration-branch-on-browser-global",
    "guideline": "rendering-hydration-no-flicker",
    "bad": "'use client'; function Panel(){return typeof window==='undefined'?<p>server</p>:<p>client</p>}",
    "good": "'use client'; function Panel(){return <p>same initial output</p>}"
  },
  {
    "rule": "react-doctor/no-locale-format-in-render",
    "guideline": "rendering-hydration-suppress-warning",
    "bad": "'use client';const date=new Date('2020-01-01');function Panel(){return <p>{new Intl.DateTimeFormat().format(date)}</p>}",
    "good": "'use client';const date=new Date('2020-01-01');function Panel(){return <p suppressHydrationWarning>{new Intl.DateTimeFormat().format(date)}</p>}"
  },
  {
    "rule": "react-doctor/rendering-hydration-no-flicker",
    "guideline": "rendering-hydration-no-flicker",
    "bad": "import {useState,useEffect} from \"react\";function Panel(){const [theme,setTheme]=useState(\"light\");useEffect(()=>{setTheme(localStorage.getItem(\"theme\"))},[]);return <p>{theme}</p>}",
    "good": "export function Panel({initialTheme}){return <p>{initialTheme}</p>}"
  }
